# Backend
APP_NAME="AI Operations & Workflow Automation Platform"
APP_ENV=local
DATABASE_URL=postgresql+psycopg2://aiops:aiops@db:5432/aiops
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
DEMO_SEED_ENABLED=true
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-ops-workflow-platform

# Optional AI features
# Selects which LLM provider the ticket agent and risk review call: openai, anthropic or groq.
# With no API key set for the selected provider, the agent uses deterministic keyword rules.
LLM_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_INPUT_COST_PER_1M=1.25
OPENAI_OUTPUT_COST_PER_1M=10.00

# Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_INPUT_COST_PER_1M=3.00
ANTHROPIC_OUTPUT_COST_PER_1M=15.00

# Groq provider (OpenAI-compatible API). Cost fields default to 0, so set them to record cost spans.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=5
GROQ_INPUT_COST_PER_1M=0
GROQ_OUTPUT_COST_PER_1M=0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_USERNAME=operator
